# Application
APP_NAME=Laravel
APP_ENV=development
# APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domainkamu.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Admin panel
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Services
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_api_key_kamu
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@kopisthetics.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase S3 storage
FILESYSTEM_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=
AWS_ENDPOINT=
AWS_URL=

# Frontend
VITE_APP_NAME="${APP_NAME}"
